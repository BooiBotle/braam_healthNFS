# ==============================================================================
# 🏥 BRAAM HEALTH CENTRE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with actual credentials for local development.
# Do NOT check actual credentials into version control.

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anonymous-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. SMTP MAIL SERVER CONFIGURATION (NODEMAILER EDGE FUNCTION)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your-smtp-strong-password
SMTP_FROM_EMAIL=no-reply@nfsconnect.co.za
SMTP_FROM_NAME="NFS Insure | Braam Health Centre"

# ------------------------------------------------------------------------------
# 3. YOCO PAYMENT GATEWAY INTEGRATION
# ------------------------------------------------------------------------------
VITE_YOCO_PUBLIC_KEY=pk_test_your-yoco-public-key
YOCO_SECRET_KEY=sk_test_your-yoco-secret-key

# ------------------------------------------------------------------------------
# 4. WHATSAPP BUSINESS API INTEGRATION
# ------------------------------------------------------------------------------
WHATSAPP_API_TOKEN=your-whatsapp-business-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# ------------------------------------------------------------------------------
# 5. GOOGLE WALLET PASS INTEGRATION
# ------------------------------------------------------------------------------
GOOGLE_WALLET_ISSUER_ID=your-google-wallet-issuer-id
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=your-google-wallet-service-account@your-gcp-project.iam.gserviceaccount.com
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 6. GLOBAL APPLICATION CONFIG
# ------------------------------------------------------------------------------
VITE_APP_URL=http://localhost:5173
